    (pad "3" smd rect (at 3.0 -1.27) (size 1.5 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (net 4 "VBUS"))
    (pad "4" smd rect (at 3.0 1.27) (size 1.5 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (net 1 "GND"))
