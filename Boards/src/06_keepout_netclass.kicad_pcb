(kicad_pcb (version 20240108) (generator "pcb_v5_samples")
  (general (thickness 1.6))
  (paper "A4")
  (title_block (title "06 Keepout and Net Classes") (date "2026-11-18") (rev "A") (company "HQPCB Samples"))
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user)
    (37 "F.SilkS" user)
    (44 "Edge.Cuts" user)
  )
  (net 0 "")
  (net 1 "GND")
  (net 2 "VCC")
  (net 3 "USB_DP")
  (net 4 "USB_DN")
  (net 5 "PWR_5V")

  (net_class Default "default"
    (clearance 0.15)
    (trace_width 0.2)
    (via_dia 0.7)
    (via_drill 0.35)
    (add_net "GND")
    (add_net "VCC")
  )
  (net_class Power "power nets"
    (clearance 0.25)
    (trace_width 0.5)
    (via_dia 0.9)
    (via_drill 0.45)
    (add_net "PWR_5V")
  )
  (net_class USB_Diff "USB differential"
    (clearance 0.15)
    (trace_width 0.2)
    (via_dia 0.7)
    (via_drill 0.35)
    (diff_pair_width 0.2)
    (diff_pair_gap 0.2)
    (add_net "USB_DP")
    (add_net "USB_DN")
  )

  (gr_line (start 0 0) (end 55 0) (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))
  (gr_line (start 55 0) (end 55 40) (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))
  (gr_line (start 55 40) (end 0 40) (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))
  (gr_line (start 0 40) (end 0 0) (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))
  (gr_text "keepout + netclass" (at 27.5 2.5) (layer "F.SilkS")
    (effects (font (size 1.4 1.4) (thickness 0.2))))
  (gr_text "RF keepout" (at 42 18) (layer "F.SilkS")
    (effects (font (size 1.1 1.1) (thickness 0.15))))

  (segment (start 5 12) (end 20 12) (width 0.2) (layer "F.Cu") (net 3))
  (segment (start 5 14) (end 20 14) (width 0.2) (layer "F.Cu") (net 4))
  (segment (start 5 28) (end 25 28) (width 0.5) (layer "F.Cu") (net 5))
  (via (at 25 28) (size 0.9) (drill 0.45) (layers "F.Cu" "B.Cu") (net 5))
  (segment (start 25 28) (end 40 28) (width 0.5) (layer "B.Cu") (net 5))

  (zone (net 0) (net_name "") (layers "F.Cu" "B.Cu") (hatch edge 0.5)
    (connect_pads (clearance 0))
    (min_thickness 0.25)
    (keepout
      (tracks not_allowed)
      (vias not_allowed)
      (pads allowed)
      (copperpour not_allowed)
      (footprints allowed)
    )
    (fill (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon (pts (xy 34 8) (xy 50 8) (xy 50 24) (xy 34 24)))
  )

  (zone (net 0) (net_name "") (layer "F.Cu") (hatch edge 0.5)
    (connect_pads (clearance 0))
    (min_thickness 0.25)
    (keepout
      (tracks allowed)
      (vias not_allowed)
      (pads not_allowed)
      (copperpour not_allowed)
      (footprints not_allowed)
    )
    (fill (thermal_gap 0.5) (thermal_bridge_width 0.5))
    (polygon (pts (xy 5 32) (xy 20 32) (xy 20 38) (xy 5 38)))
  )

  (zone (net 1) (net_name "GND") (layer "B.Cu") (hatch edge 0.5)
    (connect_pads yes (clearance 0.3))
    (min_thickness 0.25)
    (fill yes (thermal_gap 0.4) (thermal_bridge_width 0.3))
    (polygon (pts (xy 3 8) (xy 28 8) (xy 28 24) (xy 3 24)))
    (filled_polygon (layer "B.Cu") (pts (xy 3.2 8.2) (xy 27.8 8.2) (xy 27.8 23.8) (xy 3.2 23.8)))
  )
)
