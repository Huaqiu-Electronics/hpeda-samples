#!/bin/bash
# 在 Samples/sdk/go 模块下跑 numbered sample（replace 到仓库 sdk/go/hqeda）。
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
NAME="${1:-}"
if [[ -z "$NAME" ]]; then
  echo "usage: ./run <01_hello_ping|...> [args...]" >&2
  exit 2
fi
shift || true
if [[ ! -d "$HERE/$NAME" ]]; then
  echo "missing sample: $HERE/$NAME" >&2
  exit 1
fi
cd "$HERE"
exec go run "./$NAME" "$@"
